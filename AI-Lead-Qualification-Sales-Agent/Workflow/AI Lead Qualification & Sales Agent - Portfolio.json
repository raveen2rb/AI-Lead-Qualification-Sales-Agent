    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(item=>item.json).filter(row=>row&&(row.message||row.sender));const message=String($('Normalize Customer Message').item.json.message||'').trim();const managerPhrases=['talk to your manager','talk to the manager','speak to your manager','speak to the manager','talk to a human','speak to a human','talk to a real person','speak to a real person','talk to a person','speak to a person','connect me with a manager','connect me to a manager','i want a human','i need a human','i want to talk to a human','i want to speak to a human','i want to talk to your manager','i want to speak to your manager','i wanna talk to human','i wanna talk to your manager','connect me to human','connect me with human','connect me to a human','connect me with a human','connect me to your manager','connect me with your manager'];const isManagerRequest=text=>managerPhrases.some(p=>String(text||'').toLowerCase().trim().includes(p));const events=rows.map(row=>{const sender=String(row.sender||'');const text=String(row.message||'');let type=null;if(sender==='manager_resume_ai')type='resume_ai';else if(sender==='manager'||sender==='customer_manager_request')type='handoff';else if(isManagerRequest(text))type='handoff';if(!type)return null;const time=new Date(row.message_created_at||row.createdAt||0).getTime();return{type,time:Number.isFinite(time)?time:0,id:Number(row.id||0)}}).filter(Boolean);if(isManagerRequest(message))events.push({type:'handoff',time:Date.now(),id:Number.MAX_SAFE_INTEGER});events.sort((a,b)=>(b.time-a.time)||(b.id-a.id));const latestEvent=events[0];const managerRequested=isManagerRequest(message);const handoffActive=managerRequested||latestEvent?.type==='handoff';return[{json:{message,sessionId:$('Normalize Customer Message').item.json.sessionId,handoffActive,managerRequested}}];"
      },
