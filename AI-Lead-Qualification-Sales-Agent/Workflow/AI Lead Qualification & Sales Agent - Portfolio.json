    {
      "parameters": {
        "jsCode": "const oldLead=$('Get row(s)').item.json;const newLead=$('Extract Lead Information').item.json.output;const merged={service:newLead.service||oldLead.service||'',business_type:newLead.business_type||oldLead.business_type||'',budget:newLead.budget||oldLead.budget||'',timeline:newLead.timeline||oldLead.timeline||'',requirements:newLead.requirements||oldLead.requirements||'',sessionId:oldLead.sessionId||$('Normalize Customer Message').item.json.sessionId,lead_created_at:oldLead.lead_created_at||new Date().toISOString(),lead_id:oldLead.id||null};merged.lead_status=merged.service&&merged.budget&&merged.timeline?'qualified':'not_qualified_yet';return[{json:merged}];"
