    {
      "parameters": {
        "jsCode": "const text=String($json.message?.text||'').trim();const repliedText=String($json.message?.reply_to_message?.text||'');const match=repliedText.match(/Session ID:\\s*([^\\s]+)/i);const sessionId=match?match[1]:'';const resumeAiPatterns=[/^\\/ai\\s*$/i,/^(?:now\\s+)?(?:connect|switch|go|hand|give)\\s+(?:back\\s+)?(?:to\\s+)?ai\\s*$/i,/^(?:now\\s+)?let\\s+(?:the\\s+)?ai\\s+(?:handle|take\\s+over)\\s*$/i,/^(?:now\\s+)?ai\\s+(?:can\\s+)?(?:handle|take\\s+over|continue|resume)\\s*$/i,/^(?:connect|switch)\\s+(?:it\\s+)?back\\s+to\\s+ai\\s*$/i,/^great,?\\s+now\\s+you\\s+connect\\s+to\\s+ai\\s*$/i];const isResumeCommand=resumeAiPatterns.some(p=>p.test(text));return[{json:{sessionId,message:text,sender:isResumeCommand?'manager_resume_ai':'manager',message_created_at:new Date().toISOString()}}];"
